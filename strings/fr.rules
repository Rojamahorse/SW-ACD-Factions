Missions
{
	ResourceDelivery = "Approvisionnement"
	ResourceDeliveryDesc = "{to_ship} demande un approvisionnement d'urgence en {target_count} {resource_icon} {resource_type_plural} dans un délai de {time_limit_minutes} minutes. En plus du paiement standard pour chaque {resource_type} livrée, un bonus supplémentaire de {money} sera versé une fois la livraison complète effectuée."
	Bounty = "Prime diffusée sur l'HoloNet"
	BountyDesc = "Un vaisseau de classe <b>{target_ship}</b> en fuite est recherché pour activités illégales dans le système de {mission_location}. Les autorités de {faction_name} ont émis une prime de {money} pour tout pilote capable de l’éliminer."
	FleetBounty = "Prime sur l’escadron hors-la-loi "
	FleetBountyDesc = "Un groupe de vaisseaux hors-la-loi est recherché pour avoir harcelé et extorqué des civils dans le système de {mission_location}. Les autorités de {faction_name} ont émis une prime de {money} pour tout pilote capable de les éliminer."
	PirateHunt = "Fléau pirate"
	PirateHuntDesc = "Des pirates itinérants attaquent les cargos civils dans le système de {mission_location}, perturbant les routes commerciales des entreprises locales. Les commerçants ont offert une prime de {money} pour tout pilote capable d’en éliminer {target_count}."
	FactionHunt = "Traqueur de{target_faction}"
	FactionHuntDesc = "La {faction_name} est en conflit avec la {target_faction} et offre un paiement de {money} à toute personne capable d’éliminer {target_count} de leurs vaisseaux en patrouille dans le système de {mission_location}."
	ClearAsteroidField = "Nettoyage du champ d'astéroïdes"
	ClearAsteroidFieldPiratesDesc = "Quelques pirates ont pris pour cible des vaisseaux miniers civils dans un champ d'astéroïdes à proximité. Les guildes minières ont offert une prime de {money}, payable à tout pilote stellaire capable de débarrasser le champ d'astéroïdes des pirates."
	ClearAsteroidFieldPlatformsDesc = "Des pirates ont construit plusieurs tourelles de défense fixes dans un champ d'astéroïdes à proximité, rendant la zone dangereuse pour les mineurs civils légitimes. Les guildes minières ont offert une prime de {money}, payable à tout pilote stellaire capable d'éliminer ces tourelles de défense."
	StationContact = "Contact {contact_ship}"
	StationContactDesc = "{contact_ship} sollicite de l’aide auprès de tous les pilotes stellaires disponibles pour l’accomplissement de diverses missions. En guise d'incitation supplémentaire, le tableau des missions de la station offre un bonus de {money} au premier pilote stellaire qui visitera la station."
	StationRescue = "SOS de station"
	StationRescueDesc = "Un signal de détresse a été reçu de {contact_ship} ! Des pillards attaquent la station en nombre écrasant ! Le gouverneur de la station promet {money} à tout pilote stellaire capable de détruire les pillards et de sécuriser la station."
	PirateBaseDestruction = "Anéantir la forteresse pirate"
	PirateBaseDestructionDesc = "L'emplacement de la forteresse d'une flotte pirate locale a été découvert ! Ces pirates ont attaqué les vaisseaux de patrouille de {faction_name} dans le système et doivent être éradiqués. Les autorités de {faction_name} ont émis une prime substantielle de {money}, payable à tout pilote stellaire suffisamment courageux et compétent pour la détruire."
	FactionBaseDestruction = "Détruire le Poste Avancé de {target_faction}"
	FactionBaseDestructionDesc = "La {faction_name} est en conflit avec la {target_faction} et offre un paiement de {money} à toute personne capable de détruire l'un de ses postes de ravitaillement dans le système de {mission_location}."
	Explore = "Exploration {mission_location} ({discover_perc:0}%)"
	ExploreDesc = "Les navigateurs de la {faction_name} demandent des informations sur divers points d'intérêt dans le système de {mission_location}."
	VisitSystem = "Étudier {mission_location}"
	VisitSystemDesc = "Un astrophysicien de renom demande des données sur l'activité stellaire dans le système de {mission_location}."
	Debug = "Mission de débogage"
	DebugDesc = "Lorem ipsum dolor sit amet, consectetur adipiscing elit. Donec sodales rutrum eros. Fusce non eros a lacus luctus auctor sit amet at mi. In ac fermentum est. Nam viverra lectus eu turpis cursus vestibulum."
	ClearRogueElements = "Neutraliser la flotte hors-la-loi"
	ClearRogueElementsDesc =  "Un escadron autrefois sous le commandement de la \"{faction_name}\" s'est rebellé et s’est réfugié auprès d’une flotte locale de hors-la-loi dans un champ d’astéroïdes dense du système de {mission_location}. Composé de vaisseaux de diverses classes, cet escadron utilise la complexité du terrain pour lancer des attaques surprises, perturbant la stabilité locale et représentant une menace sérieuse. La {faction_name} recherche d’urgence un pilote chevronné capable de naviguer dans le champ d’astéroïdes, de neutraliser cet escadron et de rétablir l’ordre dans le secteur. Une prime substantielle de {money} est promise à quiconque parviendra à éliminer cette menace insaisissable.\n\n"\
		"<bad>Avertissement : cette mission est dangereuse et ne devrait être tentée que par des pilotes expérimentés disposant des compétences nécessaires.</bad>"
	DefeatRenegadeLeader = "Éliminer \"{target_ship}\", le redoutable chef hors-la-loi"
	DefeatRenegadeLeaderDesc = "Un chef hors-la-loi notoire connu sous le nom de \"{target_ship}\" sème le chaos dans le système {mission_location}. Commandant un vaisseau équipé d’une technologie avancée et d’une puissance de feu considérable, cette cible de haute valeur représente une menace majeure pour la stabilité régionale. La {faction_name} a mis une prime substantielle de {money} pour tout pilote expérimenté capable d’affronter et de neutraliser cette menace. Les rapports des services de renseignement soulignent l’importance stratégique de cette mission, suggérant que l’élimination de '{target_ship}' porterait un coup significatif à leurs activités néfastes.\n\n"\
		"<bad>Avertissement : cette mission est dangereuse et ne devrait être tentée que par des pilotes expérimentés disposant des compétences nécessaires.</bad>"
	RescueVIP = "Sauver l'émissaire"
	RescueVIPDesc = "Un appel de détresse urgent a été émis par un vaisseau civil en panne, actuellement assiégé par des chasseurs de primes. À son bord se trouve une personnalité de grande importance pour la {faction_name}. Une assistance immédiate est requise pour repousser les assaillants, permettant ainsi au vaisseau d’effectuer les réparations nécessaires à ses hyperpropulseurs et de prendre la fuite. La {faction_name} offre une récompense substantielle de {money} pour la défense réussie et l’extraction sécurisée de la personnalité. Une action rapide et décisive est cruciale pour éviter une aggravation de la situation."
}
