CommonStringModName = 	"\n<s16><gray>Mod: SW:ACD Factions</gray></s16>"


Parts
{
	//X-Wing Cannons Unlock
	xwingCannons = "Canon de X-Wing"
	xwingCannonsDesc = "Les canons de X-Wing sont des petites armes qui peuvent être placées et dissimulées sous et derrière les blindages. Ils sont utiles dans les engagements à moyenne et longue portée.<string id='CommonStringModName'/> \n\n <s20>Dévérouille :</s20>\n\n<good>●  <string id='Parts/xwingCannon'/>\n●  <string id='Parts/xwingCannonLeft'/>\n●  <string id='Parts/xwingCannonXLong'/>\n●  <string id='Parts/xwingCannonXLongLeft'/></good>"

	// Standard X-Wing Cannons
	xwingCannon = "Canon court de X-Wing"
	xwingCannonIcon = "X-Wing CC"
	xwingCannonLeft = "Canon court de X-Wing (Côté)"
	xwingCannonLeftIcon = "X-Wing CC (Côté)"
	xwingCannonDesc = "La <cyan>Corporation Incom</cyan> présente le canon court de X-Wing : un canon compact à canon court, conçu pour une intégration furtive dans le blindage. Il est particulièrement efficace à moyenne portée. <string id='CommonStringModName'/>"

	//Mass-Drivers Unlocks
	massdriverssmall = "Canon compact à accélérateur de masse"
	massdriverssmallDesc = "<string id='Parts/massdriversmallDesc'/>\n\n <s20>Dévérouille :</s20>\n\n<good>●  <string id='Parts/massdriversmall'/>\n●  <string id='Parts/massdriversmallLeft'/></good>"

	//Compact Mass-Driver Cannon
	massdriversmall = "Canon compact à accélérateur de masse"
	massdriversmallIcon = "Canon compact à accélérateur de masse CCAM "
	massdriversmallLeft = "Canon compact à accélérateur de masse (Côté)"
	massdriversmallLeftIcon = "Canon compact à accélérateur de masse CCAM (Côté)"
	massdriversmallDesc = "Le canon compact à accélérateur de masse est une arme cinétique redoutable malgré son format réduit, conçu pour allier précision et puissance lors des combats spatiaux rapprochés. Son design épuré permet d'être intégré à une grande variété de chasseurs stellaires, assurant un impact cinétique inégalé tout en préservant l'efficacité aérodynamique de l’appareil. <string id='CommonStringModName'/>"
	
	//Extra Long X-Wing Cannons
	xwingCannonXLong = "Canon allongé de X-Wing"
	xwingCannonXLongIcon = "X-Wing CA"
	xwingCannonXLongLeft = "Canon allongé de X-Wing (Côté)"
	xwingCannonXLongLeftIcon = "X-Wing CA (Côté)"
	xwingCannonXLongDesc = "La <cyan>Corporation Incom</cyan> présente le canon allongé de X-Wing : une version allongée du canon classique, combinant portée et furtivité avec un positionnement stratégique derrière le blindage. <string id='CommonStringModName'/>"

	//TIE Repeaters Unlocks
	tieMiniguns = "Canon à répétition de TIE"
	tieMinigunsDesc = "<string id='Parts/tieLMinigunDesc'/>\n\n <s20>Dévérouille :</s20>\n\n<good>●  <string id='Parts/tieMinigun'/>\n●  <string id='Parts/tieMinigunLeft'/></good>"

	//Standard TIE Repeaters
	tieMinigun = "Canon à répétition de TIE - édition spéciale"
	tieMinigunIcon = "TIE CR-ES"
	tieMinigunLeft = "Canon à répétition de TIE - édition spéciale (Côté)"
	tieMinigunLeftIcon = "TIE CR-ES (Côté)"
	tieLMinigunDesc = "Le canon à répétition de TIE édition spéciale de l'<cyan>Empire Galactique</cyan> est un canon compact à tir rapide, idéal pour le combat rapproché. Son design furtif permet une intégration discrète au sein du blindage.<string id='CommonStringModName'/>"

	//Hycor Heavy Repeaters Unlocks
	tieMinigunsLong = "Répéteur laser lourd HyCor"
	tieMinigunsLongDesc = "<string id='Parts/tieLMinigunLongDesc'/>\n\n <s20>Dévérouille :</s20>\n\n<good>●  <string id='Parts/tieMinigunLong'/>\n●  <string id='Parts/tieMinigunLongLeft'/></good>"

	tieMinigunLong = "Répéteur laser lourd HyCor - canon allongé"
	tieMinigunLongIcon = "HyCor RLL-CA"
	tieMinigunLongLeft = "Répéteur laser lourd HyCor - canon allongé (Côté)"
	tieMinigunLongLeftIcon = "HyCor RLL-CA (Côté)"
	tieLMinigunLongDesc = "Le répéteur laser lourd avec canon allongé usiné par <cyan>HyCor</cyan> est un laser lourd à tir rapide qui est parfaitement adapté aux engagements à courte portée. Il est modifié pour une utilisation sur des vaisseaux de petite à moyenne taille. Peut être installé derrière ou sous le blindage du vaisseau.<string id='CommonStringModName'/>"

	//RG9 Cannons Unlocks
	RG9Cannons = "Canon laser RG-9"
	RG9CannonsDesc = "<string id='Parts/RG9CannonDesc'/>\n\n <s20>Dévérouille :</s20>\n\n<good>●  <string id='Parts/RG9Cannon'/>\n●  <string id='Parts/RG9CannonLeft'/></good>"

	// RG-9 Cannons
	RG9Cannon = "Canon laser RG-9 - édition améliorée"
	RG9CannonIcon = "RG-9 CL-EA"
	RG9CannonLeft = "Canon laser RG-9 - édition améliorée (Côté)"
	RG9CannonLeftIcon = "RG-9 RCL-EA (Côté)"
	RG9CannonDesc = "Le canon laser RG-9 par <cyan>Borstel</cyan> est une édition améliorée du petit laser d’A-Wing, rapide et polyvalent, principalement utilisé sur des chasseurs de taille moyenne à grande.<string id='CommonStringModName'/>"
	RG9CannonLeftDesc = "Le canon laser RG-9 par <cyan>Borstel</cyan> est une édition améliorée du petit laser d’A-Wing, rapide et polyvalent, principalement utilisé sur des chasseurs de taille moyenne à grande.<string id='CommonStringModName'/>"

	// Standard TwinBeam Defense Turret
	DroidTurret = "Tourelle de défense à double rayon StarGuard"
	DroidTurretIcon = "Starguard TDDR"
	DroidTurretDesc = "Issu des ateliers d'une filiale de la <cyan>Corporation Technique Corellienne</cyan>, la tourelle de défense à double rayon StarGuard déchaîne une pluie de tirs, offrant une protection inégalée. Particulièrement efficace pour intercepter et neutraliser les <orange>tirs laser et à ions</orange>, elle assure une défense supérieure contre les menaces à projectiles énergétiques, mais reste inefficace contre les balles, mines et missiles.<string id='CommonStringModName'/>"

	// Mini TwinLaser Defense Turret
	PDTurretTiny = "Tourelle de défense rapprochée compacte à double laser StarGuard"
	PDTurretTinyIcon = "Starguard TDRCDL"
	PDTurretTinyDesc = "La tourelle de défense rapprochée compacte à double laser StarGuard, fabriquée par <cyan>ArmsTech</cyan>, déchaîne une déchaîne une pluie de tirs laser. Cette version miniaturisée et entièrement automatisée est optimisée pour les espaces restreints. Elle est particulièrement efficace contre les <orange>balles, mines et missiles</orange>, mais reste inefficace face aux tirs laser et à ions.<string id='CommonStringModName'/>"


//	//Long X-Wing Cannons
//	xwingCannonLong = "Canon blaster RedFury"
//	xwingCannonLongIcon = "Canon blaster RedFury"
//	xwingCannonLongLeft = "Canon blaster RedFury (Côté)"
