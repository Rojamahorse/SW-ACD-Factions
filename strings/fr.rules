MapSizes  
{
	Standard = "Cosmoteer Standard (50)"
	StandardTip = "Un système stellaire basique de <white>Cosmoteer</white>, de taille standard, ennuyeux et sans intérêt... \n<i>Ce ne sont pas les systèmes stellaires que vous cherchez... circulez, circulez.</i>"
	
	Vanilla = "Standard (50)"
	VanillaDesc = "Un mélange de 50 systèmes stellaires de <yellow>Star Wars</yellow> et de <white>Cosmoteer</white>, situés à la frontière de l’espace exploré, connus pour leurs routes complexes et leurs affaires louches."

//	SWStandard = "Systèmes Frontaliers (50)"
//	SWStandardTip = "Un réseau de 50 systèmes de <yellow>Star Wars</yellow> situés à la frontière de l’espace exploré, connus pour leurs routes complexes et leurs affaires louches."

	SWLarge = "Bordure Extérieure (60)"
	SWLargeDesc = "Une région frontalière sans foi ni loi, avec 60 systèmes de <yellow>Star Wars</yellow>."

	SWVeryLarge = "Bordure Médiane (80)" 
	SWVeryLargeDesc = "Une région industrialisée, avec 80 systèmes de <yellow>Star Wars</yellow>."

	SWHuge = "Bordure Intérieure (100)"
	SWHugeDesc = "Une région prospère avec 100 systèmes de <yellow>Star Wars</yellow>." 

	SWGigantic = "Mondes du Noyau (125)"
	SWGiganticDesc = "Le cœur de la civilisation galactique avec 125 systèmes de <yellow>Star Wars</yellow>."

	SWColossal = "Noyau Profond (150)"
	SWColossalDesc = "Une région dangereuse aux confins du Noyau Profond avec 150 systèmes de <yellow>Star Wars</yellow>."

	SWTitanic = "Régions Inconnues (200)"
	SWTitanicDesc = "Un vaste territoire inexploré, enveloppé de mystère, avec 200 systèmes contrôlés par des factions de <yellow>Star Wars</yellow> et de <white>Cosmoteer</white>."

	SWGalactic = "La Totalité de la Galaxie Connue (500)"
	SWGalacticDesc = "Les factions de <white>Cosmoteer</white> et de <yellow>Star Wars</yellow> s'affrontent dans toute la galaxie connue, avec 500 systèmes."

	// The Rebellion Era Galaxy Map
	SWRebellion = "Un Nouvel Espoir (50)"
	SWRebellionDesc = "Un véritable classique de <yellow>Star Wars</yellow> bourré d'action : vous êtes pris en plein milieu du conflit alors que l'<orange>Alliance Rebelle</orange> affronte l'<gray>Empire</gray>..."

	// The Clone Wars Era Galaxy Map
	SWClonewars = "La Guerre des Clones (50)"
	SWClonewarsDesc = "Entrez au cœur de la <yellow>Guerre des Clones</yellow>, où la <red>République Galactique</red> affronte la <blue>Confédération des Systèmes Indépendants (CIS)</blue>, tandis que le <magenta>Soleil Noir</magenta> rôde dans l'ombre. Vivez la tourmente galactique emblématique d'une période connue sous le nom de '<yellow>Tension Galactique</yellow>'." 

	/*
	SmugglersRun = "La course des contrebandiers (50)"
	SmugglersRunDesc = "Un réseau de 50 systèmes stellaires connus pour leurs routes complexes et leurs affaires louches, souvent fréquenté par des contrebandiers et des hors-la-loi."
	*/
}

CareerModeConfig
{
  Name = "Héritage galactique"
  Description = "Construisez, combattez et piller pour devenir un commandant de vaisseau légendaire au milieu des étoiles."
  DescriptionMP = "Tracez un chemin à travers une galaxie façonnée par la Force, en accomplissant des missions épiques, en combattant des factions opposées et en collectant des ressources. "\
                "Unissez vos forces avec jusqu'à quatre chefs d'escouade dans une aventure multijoueur coopérative."

  CombatDifficulty = "Prouesses de combat"
  CombatDifficultyTip = "Choisissez votre voie dans les étoiles : deviendrez-vous le gardien de la paix de la galaxie ou son pire cauchemar ?"
  
  EconDifficulty = "Economie galactique"
  EconDifficultyTip = "Allez-vous plonger dans une piscine de crédits ou en économiser le plus possible ?"
  
  CrewScarcity = "Recrutement par persuasion de Force"
  CrewScarcityTip = "Utiliser la persuasion de Force pour amener les recrues potentielles à croire que vous êtes la légende qu’ils attendaient. Un 'pouvoir' plus puissant signifie plus de bras à bord, vous permettant de naviguer dans les étoiles avec aisance, sans pour autant alerter les grands méchants du secteur."

  DisableCrewConstruction = "Assemblage par la Force"
  DisableCrewConstructionTip = "Activez cette capacité pour canaliser la Force, permettant à votre volonté de se manifester instantanément permettant d'effectuer de modifications de votre vaisseau n'importe où dans la galaxie, sans avoir besoin du moindre effort de la part de votre équipage."

  DisableExploration = "Clairvoyance de la Force"
  DisableExplorationTip = "Qui a besoin d'éclaireurs ou de sondes quand on a la Force ? Utilisez votre Yoda intérieur pour voir tous les secrets de la galaxie, des marais de Dagobah jusqu'aux cantinas de Tatooine, le brouillard de guerre n'est plus là pour obscurcir votre vision cosmique."

  DisableSalvaging = "Détour par la décharge stellaire"
  DisableSalvagingTip = "● Les récompenses des missions sont doublées : comme si vous aviez parié sur la défaite de Sebulba.\n"\
                        "● Qui a besoin de ferraille ? Les vaisseaux ne peuvent pas être transformés en ressources ! Ce ne sont pas des droïdes ! \n"\
                        "● Il suffit de sortir des crédits pour résoudre le problème, aucune équipe de construction n'est nécessaire."

  CantDisableSalvagingTip = "Note: Le mode 'Détour par la Décharge Stellaire' nécesssite que le mode 'Assemblage par la Force' soit activé."

  GalaxySeed = "Coordonnées de voie hyperspatiale"
  GalaxySeedTip = "Ce sont les coordonnées utilisées par l’ordinateur de navigation pour voyager dans l’hyperespace. Elles définissent la structure de l’espace-temps. Si on entre les mêmes données, on obtient toujours la même carte des étoiles. Peu importe la réalité ou l’époque."

  MapSize = "Balayage du secteur"
  MapSizeTip = "Détermine l'étendue de l'espace connu, de la Bordure Extérieure jusqu'aux Mondes du Noyau. Le chiffre indique le nombre de systèmes qu'il reste à cartographier."

  //MaxPlayers = &~/PvpModeConfig/MaxPlayers
  //MaxPlayersTip = &~/PvpModeConfig/MaxPlayersTip

ShipInfoFmt = "<s24>{0}</s24>\n\n{1}\n\nCrédits galactiques restant: {2}"
CustomShipInfoFmt = "<s24>{0}</s24> - Vaisseau spatial personnalisé\n\nCrédits galactiques restant: {1}"
LoadShip = "Déployer le vaisseau spatial personnalisé"
PlayerTeamFmt = "Chef d’escouade {0}"
SharedPlayerTeamFmt = "Escadron allié {0}"
Advanced = "Paramètres d'Holocron"
AdvancedInfo = "Ajustez ici la trame du cosmos ! Ces options vous permettent de remodeler le jeu. Expérimentez à vos risques et périls… mais souvenez-vous : la Force est bien plus amusante quand elle est un peu imprévisible."
}

CrewScarcity
{
	Max = "Convergence galactique"
	MaxTip = "Avec pas moins de <yellow>3000</yellow> membres d’équipage disponibles pour être recrutés, c’est comme organiser un sommet intergalactique à bord de votre vaisseau. Parfait pour les commandants qui apprécient un équipage animé et diversifié, garantissant qu’aucun recoin de la galaxie ne reste inexploré."
	SWPlentifulPlus = "Assemblée de Jedi"
	SWPlentifulPlusTip = "Ce niveau offre <good>100%</good> de membres d’équipage en plus, jusqu’à un nombre impressionnant de <yellow>3000</yellow> membres d’équipage. C’est comme rassembler un conclave Jedi : beaucoup de mains habiles pour chaque tâche. Idéal pour les capitaines qui veulent la force d’une petite armée, sans les sabres laser."
	SWPlentiful = "Réunion à la cantina"
	SWPlentifulTip = "Avec <good>66%</good> de membres d’équipage en plus, jusqu’à <yellow>2500</yellow> membres d’équipage, c’est comme une nuit animée à la Cantina de Mos Eisley. Un groupe diversifié et vivant, prêt à relever tous les défis de la galaxie. Parfait pour ceux qui apprécient un équipage aussi varié que les habitués d’une taverne de Tatooine"
	Plentiful = "Rassemblement des rebelles"
	PlentifulTip = "Avec <good>33%</good> de membres d’équipage en plus, jusqu’à un maximum de <yellow>2000</yellow> membres d’équipage, ce niveau reflète un rassemblement de l'Alliance Rebelle. Parfait pour les capitaines qui désirent un équipage solide, chaque membre aussi passionné et dévoué qu’un combattant de la liberté de Yavin IV. »"
	Standard = "Standard"
	StandardTip = "Le nombre standard de membres d’équipage sera disponible au recrutement en fonction de la renommée du joueur, jusqu’à un maximum de <yellow>1500</yellow> membres d’équipage."
	Scarce = "Équipage de contrebandier"
	ScarceTip = "Avec <bad>33%</bad> de membres d’équipage en moins, limité à <yellow>1000</yellow> membres d’équipage, ce niveau ressemble à un équipage de contrebandiers soudé. Chaque membre est aussi crucial qu’un copilote lors d’un Raid de Kessel, rendant chaque voyage à la fois palpitant et stratégique."
}

CombatDifficulty
{
  NoDeath = "Pacifique (Invulnérable)"
  NoDeathTip = "• Aucun dégât subi\n<i><gray>(Des dégâts ? Qu'est-ce que c'est ?)</gray></i>\n• Possibilité de construire lors d'un combat\n<i><gray>(Je ne blesserais même pas un mynock.)</gray></i>"
  
  Easy = "Éleveur de Nerfs" 
  EasyTip = "• <good>-30%</good> de dégâts subis\n<i><gray>(J’ai failli rater l’école de pilotage.)</gray></i>\n• <good>+40%</good> de dégâts infligés\n<i><gray>(Je suis encore moins précis qu’un stormtrooper.)</gray></i>"

  Normal = "Chasseur de primes amateur"
  NormalTip = "• Dégâts subis normaux\n<i><gray>(je pilote bien.)</gray></i>\n• Dégâts infligés normaux\n<i><gray>(Je ne rate que la moitié de mes tirs.)</gray></i>"

  Hard = "Escadron Rogue"
  HardTip = "• <bad>+25%</bad> de dégâts subis\n<i><gray>(J’ai obtenu les meilleures notes de ma promotion.)</gray></i>\n• <bad>-20%</bad> de dégâts infligés\n<i><gray>(Je m’entraînais à tirer sur des rats womp avec mon T-16 chez moi.)</gray></i>"

  VeryHard = "Contrebandier légendaire"
  VeryHardTip = "• <bad>+40%</bad> de dégâts subis\n<i><gray>(J'ai fait le raid de Kessel en moins de 12 parsecs !)</gray></i>\n• <bad>-30%</bad> de dégâts infligés\n<i><gray>(Tu sais, moi et les probabilités.)</gray></i>"
}


EconDifficulty
{
  FreeBuild = "Maître de la Force"
  FreeBuildTip = "• Des pouvoirs illimités de la Force permettent de construire n'importe où et n'importe quand, sans crédits ni ressources.\n<i><gray>(Un taux élevé de midichloriens, ça aide bien.)</gray></i>\n• Taux de récupération des ressources normal.\n<i><gray>(Les ressources coulent aussi naturellement que la Force.)</gray></i>\n• Récompenses en crédits normales.\n<i><gray>(Les crédits feront l'affaire.)</gray></i>\n• Récompenses en réputation normales.\n<i><gray>(Ta réputation te précède.)</gray></i>"
  
  Fast = "Contrebandier" 
  FastTip = "• Taux de récupération des ressources <good>augmenté de 100%</good>.\n<i><gray>(Shhh, ne demande pas d'où ça vient.)</gray></i>\n• Récompenses en crédits <good>augmentées de 100%</good>.\n<i><gray>(Sans taxes, bien sûr.)</gray></i>\n• Récompenses en réputation <good>augmentés de 50%</good>.\n<i><gray>(La renommée se propage vite dans les bas-fonds.)</gray></i>"

