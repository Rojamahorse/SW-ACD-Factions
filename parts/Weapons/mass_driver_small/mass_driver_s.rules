//OVERCLOCK
//{
//	BULLET = &<./Data/shots/bullet_railgun/overclock/bullet_railgun_overclock.rules>
//	SHOT_HEAT_PER_MODULE = 1750
//	BASE_CHARGE_TIME = 0.5
//	MODULE_CHARGE_TIME = 0.125
//	RECOIL_FACTOR = 250%
//}

Part : &<../../base_part_terran_weapons.rules>/Part
//Part :  <./Data/ships/terran/base_part_terran.rules>/Part 
{
	//IDs
	ID = SW.fighter_mass_driver_cannon
	OtherIDs = [SW.fighter_long_xwing_cannon, SW.3.fighter_long_xwing_cannon] //Clears the array

	//StringKeys
	NameKey = "Parts/massdriversmall"
	IconNameKey = "Parts/massdriversmallIcon"
	DescriptionKey = "Parts/massdriversmallDesc"
		
	//Groups&Categories
	EditorGroups = ["WeaponsEnergy","SWTechI"]
	TypeCategories = [weapon, uses_power, fighter]
	SignificanceToggle = ScorchedToggle
	
	//Resources&Size&Health
	Resources
	[
		[steel, 48]
		[coil2, 25]
	]
	Size = [1, 1]
	MaxHealth = 2000
	
	//Rects
	PenetrationRectType = Normal
	//ProhibitRects
	//[
	//	[fighter, [0, -3, 1, 3]]
	//]
	
	//Selections
	SelectionTypeID = "fighter"
	SelectionPriority = 1
	SelectionTypeByRotation = true
	
	//PartSpecific
	Density = 0.5
	InitialPenetrationResistance = 1
	
	//ReceivableBuffs
	ReceivableBuffs : ^/0/ReceivableBuffs []
	//ProhibitedBy : ^/0/ProhibitedBy [fighter]
	
	//Doors&Etc
	AllowedDoorLocations
	[
		[-1, 0]
		[1, 0]
		[0, 1]
	]
	
	//Editor
	EditorIcon
	{
		Texture
		{
			File = "icon.png"
			SampleMode = Linear
		}
		Size = [16, 64]
	}
	
	//Components
	Components : ^/0/Components
	{
		IsOperational
		{
			Type = MultiToggle
			Toggles = [PowerToggle, BatteryStorage, ScorchedToggle/*, &~/Part/^/0/OVERCLOCK_OPERATIONAL*/]
			Mode = All
		}

		CommandConsumptionToggle
		{
			Type = MultiToggle
			Toggles = [PowerToggle, ScorchedToggle]
			Mode = All
		}

		PowerToggle
		{
			Type = UIToggle
			ToggleID = "on_off"
			Default = 1
			RequiresCommand = false
		}

		ScorchedToggle
		{
			Type = StatusToggle
			StatusType = cosmoteer.scorched
			MinStatusValue = 1
			Invert = true
		}

		CommandConsumer
		{
			Type = CommandConsumer
			OperationalToggle = CommandConsumptionToggle //PowerToggle
			CommandPoints = 3
		}

		FireModeToggle
		{
			Type = UIToggle
			ToggleID = "fire_mode"
			Default = 1
			ToggledOnChoices = [0, 1, 2]
		}
		AutoTargetToggle
		{
			Type = ModeToggle
			Mode = FireModeToggle
			OnModes = [1, 2]
		}
		AutoFireToggle
		{
			Type = ModeToggle
			Mode = FireModeToggle
			OnMode = 2
		}

		BatteryStorage
		{
			Type = ResourceStorage
			ResourceType = battery
			MaxResources = 2000
			ReceiveResourceMediaEffects = &/COMMON_EFFECTS/PowerDeliver
		}
		BatteryConsumer
		{
			Type = ResourceConsumer
			ResourceType = battery
			Storage = BatteryStorage
			ResupplyThreshold = 1
			DefaultPriority = &/PRIORITIES/Weapon_Supply
			OperationalToggle = PowerToggle
		}
/*
		RailgunBuffToggle
		{
			Type = BuffToggle
			BuffType = Railgun
		}

		RailgunOperationBuffToggle
		{
			Type = BuffToggle
			BuffType = RailgunOperation
		}

		ShotBuffProvider
		{
			Type = SelfBuffProvider
			BuffType = RailgunShot
			ChainsFromBuffType = Railgun
			BuffAmount = { BaseValue=0; BuffType=Railgun; BuffMode=Add; }
		}
		Overclock_ShotBuffProvider : ShotBuffProvider
		{
			OperationalToggle = IsOverclocked
			BuffType = RailgunShotOverclock
		}

		ReverseOperationBuffProvider
		{
			Type = AreaBuffProvider
			BuffType = RailgunReverseOperation
			BuffArea = [0, 4, 2, 1]
			OperationalToggle = IsOperational
			Criteria
			{
				Rot = 0
				Left = 0
				Right = 2
				Top = 4
			}
		}
*/
		Graphics
		{
			Type = Graphics
			Location = [.5, .5]
			OperationalToggle = IsOperational
			Floor
			{
				Layer = "floors"
				DamageLevels
				[
					{
						File = "./Data/ships/terran/point_defense/floor.png"
						Size = [1, 1]
					}
					{
						File = "./Data/ships/terran/point_defense/floor_33.png"
						Size = [1, 1]
					}
					{
						File = "./Data/ships/terran/point_defense/floor_66.png"
						Size = [1, 1]
					}
				]
			}
			OperationalDoodad
			{
				Layer = "doodads_low"
				Offset = [0, -0.5]
				DamageLevels
				[
					{
						AnimationFiles
						[
							"../base/doodads_on1.png"
							"../base/doodads_on2.png"
							"../base/doodads_on3.png"
							"../base/doodads_on4.png"
							"../base/doodads_on5.png"
							"../base/doodads_on6.png"
							"../base/doodads_on7.png"
							"../base/doodads_on8.png"
						]
						NormalsAnimationFiles
						[
							"../base/doodads_normals.png"
							"../base/doodads_normals.png"
							"../base/doodads_normals.png"
							"../base/doodads_normals.png"
							"../base/doodads_normals.png"
							"../base/doodads_normals.png"
							"../base/doodads_normals.png"
							"../base/doodads_normals.png"
						]
						Size = [1, 2]
						AnimationInterval = 0.1
					}
				]
			}
			NonOperationalDoodad
			{
				Layer = "doodads_low"
				Offset = [0, -0.5]
				DamageLevels
				[
					{
						File = "../base/doodads_off.png"
						NormalsFile = "../base/doodads_normals.png"
						Size = [1, 2]
					}
				]
			}
			OperationalLighting
			{
				Layer = "lights_add"
				DamageLevels
				[
					{
						File = "../base/lights.png"
						Size = [1, 1]
					}
				]
			}
			Walls
			{
				Layer = "walls"
				DamageLevels
				[
					{
						File = "./Data/ships/terran/point_defense/walls.png"
						Size = [1, 1]
					}
					{
						File = "./Data/ships/terran/point_defense/walls_33.png"
						Size = [1, 1]
					}
					{
						File = "./Data/ships/terran/point_defense/walls_66.png"
						Size = [1, 1]
					}
				]
			}
			Roof
			{
				Layer = "roofs"
				DamageLevels
				[
					{
						File = "./Data/ships/terran/point_defense/roof.png"
						NormalsFile = "./Data/ships/terran/point_defense/roof_normals.png"
						Size = [1, 1]
					}
					{
						File = "./Data/ships/terran/point_defense/roof_33.png"
						NormalsFile = "./Data/ships/terran/point_defense/roof_normals_33.png"
						Size = [1, 1]
					}
					{
						File = "./Data/ships/terran/point_defense/roof_66.png"
						NormalsFile = "./Data/ships/terran/point_defense/roof_normals_66.png"
						Size = [1, 1]
					}
				]
			}
		}

		Turret
		{
			Type = TurretWeapon
			Location = [0.5, -0.25]
			Rotation = -90d
			OperationalToggle = IsOperational
			AutoFireToggle = AutoFireToggle
			FireInterval = 5 //.7
			FiringArc = 5d
			RotateSpeed = 360d
			FireThresholdAngle = 1d
			AIFirepowerRating = &~/Part/StatsByCategory/0/Stats/DamagePerSecond
			AllowFireWithBlockedLOS = true
			IgnoreSourceShipLowLOSChecks = true
			IgnoreFriendlyShipLowLOSChecks = false
			Emitter = BulletEmitter

			AutoTargets
			[
				{
					TargetType = ShipParts
					Toggle = FireModeToggle
				}
			]

			BlueprintArcSprite
			{
				Texture = &/INDICATORS/WeaponArc
				Size = [0, 1.5]
				Color = [255, 0, 0, 63]
			}
			BlueprintArcRadius = 10
			BlueprintArcSpriteSegments = 64

			CoverageSectorArc
			{
				Texture = &/INDICATORS/VerticalGradient
				VertexColor = [255, 255, 255, 51]
				QuadCount = 64
			}
		}

		ReloadProgressBar
		{
			Type = ProgressBar
			OperationalToggle = IsOperational
			ShowProgressFor = Turret
		}

/*
		// Prevent toggling while firing
		OverclockModeToggle : ^/0/OverclockModeToggle
		{
			OperationalToggle = ProjectileToggle
			InvertOperationalToggle = true
		}

		Overclock_ShotHeatProducer
		{
			Type = ResourceChange
			Trigger = Overclock_BulletEmitter
			Amount
			{
				PER_MODULE_RESOURCE_HEAT = (&~/OVERCLOCK/SHOT_HEAT_PER_MODULE) * (&<./Data/statuses/heat/heat.rules>/STATUS_TO_RESOURCE_RATIO)
				// 2 for the launcher and loader
				BaseValue = 2 * (&PER_MODULE_RESOURCE_HEAT)
				Modifiers
				[
					{
						Type = ScaledBuff
						BuffType = Railgun
						Scale = (&../../PER_MODULE_RESOURCE_HEAT)
						ModificationMode = Add
					}
				]
			}
			ResourceStorage = &~/Part/^/0/HEAT_TARGET_STORAGE
		}

		HeatDistributionStorage : ^/0/HeatDistributionStorage
		{
			ResourceStorages = [ &../^/0/ResourceStorages/0, Network_RailgunOverflowHeatInput ]
		}

		WeaponEmitterSelector
		{
			Type = ToggleEmitterSelector
			Toggle = IsOverclocked
			ToggleOffEmitter = BulletEmitter
			ToggleOnEmitter = Overclock_BulletEmitter
		}

*/
		BulletEmitter
		{
			Type = BulletEmitter
			ChainedTo = Turret
			FireTrigger = Turret
			GetTargetFrom = Turret
			Location = [2.28, 0]
			OperationalToggle = IsOperational
			Bullet = &<../common_shots/sw_bullet_massdriver/sw_bullet_massdriver.rules>// &<./Data/shots/bullet_railgun/bullet_railgun.rules> // &<xwing_shot/xwing_shot.rules>
			ResourceStorage = BatteryStorage
			ResourcesUsed = 500
			MinResourcesUsed = 1
		}
/*
		Overclock_BulletEmitter : BulletEmitter
		{
			FireTrigger = ProjectileFinished_Charged
			Bullet = &~/OVERCLOCK/BULLET
		}
		EmissionTriggered
		{
			Type = MultiTrigger
			Triggers = [BulletEmitter, Overclock_BulletEmitter]
		}

		WeaponTriggerProxy_NonOverclocked
		{
			Type = TriggerProxy
			ComponentID = Weapon
			ProxyToggle = IsOperationalNonOverclocked
		}

		WeaponTriggerProxy_Overclocked
		{
			Type = TriggerProxy
			ComponentID = Weapon
			ProxyToggle = IsOperationalOverclocked
		}

		OperationalOverclockDisabled
		{
			Type = ToggleTrigger
			Toggle = IsOperationalOverclocked
			TriggerWhenOn = false
			TriggerWhenOff = true
		}

		Overclock_ChargeTimerReset
		{
			Type = MultiTrigger
			Triggers = [WeaponTriggerProxy_Overclocked, OperationalOverclockDisabled]
		}
		Overclock_ChargeTimer
		{
			Type = Timer
			OperationalToggle = IsOperationalOverclocked
			Duration
			{
				BaseValue = &~/OVERCLOCK/BASE_CHARGE_TIME
				MaxValue = (&~/Part/Components/Weapon/FireInterval) - 0.5
				Modifiers
				[
					{
						Type = ScaledBuff
						BuffType = Railgun
						Scale = &~/OVERCLOCK/MODULE_CHARGE_TIME
						ModificationMode = Add
					}
				]
			}
			StartTrigger = WeaponTriggerProxy_Overclocked
			ResetTrigger = Overclock_ChargeTimerReset
			StopTrigger = OperationalOverclockDisabled
		}
		Overclock_PolledChargeTimer
		{
			Type = PolledValue
			OperationalToggle = Overclock_ChargeTimer
			InvertOperationalToggle = true
			ValueSource = Overclock_ChargeTimer
			DefaultValue = 1
		}
		Overclock_ChargeValue
		{
			Type = MultiValue
			Values = [ Overclock_PolledChargeTimer ]
			Mode = Add
			Invert = true
		}

		Overclock_HasCharged
		{
			Type = TriggeredToggle
			OnTrigger = Overclock_ChargeTimer
			OffTrigger = Overclock_BulletEmitter
			OperationalToggle = IsOperationalOverclocked
		}

		RailgunBuffValue
		{
			Type = BuffableValue
			Value = { BaseValue = 1; BuffType = Railgun; BuffMode = Multiply; }
			IncludeInBlueprints = true
		}
		Overclock_ChargeableModuleCount
		{
			Type = MultiValue
			Values = [RailgunBuffValue, One]
			Mode = Add
		}
		Overclock_ChargedModules
		{
			Type = MultiValue
			Values = [Overclock_ChargeValue, Overclock_ChargeableModuleCount]
			Mode = Multiply
		}

		ProjectileStartTrigger
		{
			Type = MultiTrigger
			Triggers = [WeaponTriggerProxy_NonOverclocked, Overclock_ChargeTimer]
		}
*/
		ProjectileToggle
		{
			Type = TriggeredToggle
			OnTrigger = Turret
			OffTrigger = Projectile
			OperationalToggle = IsOperational
		}

		Projectile
		{
			Type = RailgunProjectile
			Location = [1, 4.5]
			OperationalToggle = ProjectileToggle
			YStartOffset = { BaseValue=3; BuffType=Railgun; BuffMode=Multiply; }
			YEndOffset = -4
			SpeedStart = 360 // &../BulletEmitter/Bullet/Speed/BaseValue
			SpeedEnd = 1200 //&../BulletEmitter/Bullet/Speed
			Interpolate = true // WARNING: Only use this for interpolating graphics. Using it for game logic will cause multiplayer desyncs.
		}
/*
		ProjectileFinished_Uncharged
		{
			Type = TriggerProxy
			ComponentID = Projectile
			ProxyToggle = Overclock_HasCharged
			InvertProxyToggle = true
		}
		ProjectileFinished_Charged
		{
			Type = TriggerProxy
			ComponentID = Projectile
			ProxyToggle = Overclock_HasCharged
		}
*/
		RecoilProjectile : Projectile
		{
			Interpolate = false
		}
		RecoilTimer
		{
			Type = Timer
			OperationalToggle = ProjectileToggle
			Duration = 1/30
			AutoStart = true
			Repeats = true
			TriggerWhenStarted = true
		}
		RecoilEffects
		{
			Type = TriggeredEffects
			ChainedTo = RecoilProjectile
			Rotation = 90d
			Trigger = RecoilTimer
			HitEffects
			[
				{
					Type = Impulse
					Impulse = 200
				}
			]
		}
		FireEffect
		{
			Type = TriggeredEffects
			ChainedTo = Turret
			Trigger = Turret
			Location = [2.65, 0]
			AnchorMediaEffects = true

			MediaEffects
			[
				&<./Data/ships/terran/railgun_launcher/particles/railgun_shoot.rules>
				&<./Data/ships/terran/railgun_launcher/particles/railgun_shoot_distortion.rules>
				//&<./Data/ships/terran/laser_blaster_small/particles/laser_blaster_small_shoot.rules>
				//&<./Data/ships/terran/laser_blaster_small/particles/laser_blaster_small_shoot_flash.rules>

				: /BASE_SOUNDS/AudioExterior
				{
					Sound = "../common_effects/sounds/MassDriver.wav" // "../common_effects/sounds/XwingCannon1.wav"
					Volume = .2
					SpeedVariation = .25
				}
			]
		}
/*
		Router
		{
			Type = NetworkRouter
			RouteGenerators
			[
				{
					Type = Bidirectional
					Routes
					[
						[NetworkOverclockStateValue, Networked_ChargedModules, 0]
						[NetworkOverclockStateValue, Networked_ChargeValue, 0]
						[NetworkOverclockStateValue, Network_OverflowHeatStorage, 0]
						[NetworkOverclockStateValue, Network_RailgunOverflowHeatInput, 0]
					]
				}
				{
					Type = Simple
					Routes
					[
						[&~/Part/^/0/HEAT_NETWORK_INPUT, NetworkOverclockStateValue, 0]
					]
				}
			]
		}

		Networked_ChargedModules
		{
			Type = NetworkValue
			ValueSource = Overclock_ChargedModules
			Categories = [ railgun_charge_modules ]
		}

		Networked_ChargeValue
		{
			Type = NetworkValue
			ValueSource = Overclock_ChargeValue
			Categories = [ railgun_charge ]
		}

		Network_RailgunOverflowHeatInput
		{
			Type = NetworkResourceInput
			ResourceType = heat
			AllowUncategorized = false
			Categories = [ railgun_heat_overflow ]
		}

		Network_OverflowHeatStorage
		{
			Type = NetworkResourceStore
			ResourceType = heat
			ResourceStorage = OverflowHeatStorage
			AllowProviding = false
			Categories = [ railgun_heat_overflow ]
		}

		NetworkOverclockStateValue
		{
			Type = NetworkValue
			ValueSource = OverclockStateValue
			Categories = [ overclock ]
		}

		OverclockStateValue
		{
			Type = ToggleValueSelector
			Toggle = OverclockModeToggle
			ToggleOffValue = Zero
			ToggleOnValue = One
		}

		BlueprintNetwork_IsOverclocked
		{
			Type = NetworkToggle
			ToggleSource = OverclockModeToggle
			Categories = [ overclock ]
			IncludeInBlueprints = true
			IncludeInPhysical = false
		}

		Zero
		{
			Type = StaticValue
			Value = 0
		}
		One
		{
			Type = StaticValue
			Value = 1
		}

		Port_Rail
		{
			Type = NetworkPort
			Location = [0, 3]
			Direction = Down
			Types = [ railgun_down ]
			CompatibleTypes = [ railgun_up ]
			RouteSource = NetworkOverclockStateValue
			RouteEndpoint = NetworkOverclockStateValue
			BlueprintRouteSource = BlueprintNetwork_IsOverclocked
			BlueprintRouteEndpoint = BlueprintNetwork_IsOverclocked
			Overlay
			{
				RouteDrawMode = Never
				IconDrawMode = Never
			}
		}

		Port_Thermal_TopLeft : ~/Part/^/0/BASE_THERMAL_PORT
		{
			Location = [0, 1]
			Direction = Left
			Overlay : ^/0/Overlay
			{
				SpreadHighlightThroughNetwork = BlueprintNetwork_IsOverclocked
			}
		}
		Port_Thermal_TopRight : Port_Thermal_TopLeft
		{
			Location = [1, 1]
			Direction = Right
		}
		Port_Thermal_BottomLeft : Port_Thermal_TopLeft
		{
			Location = [0, 3]
			Direction = Left
		}
		Port_Thermal_BottomRight : Port_Thermal_TopLeft
		{
			Location = [1, 3]
			Direction = Right
		}
*/
		ToggledProjectileSprite
		{
			Type = ToggledComponents
			Toggle = ProjectileToggle
			Components
			{
				ProjectileGlowSprite
				{
					Type = Sprite
					ChainedTo = Projectile
					Layer = "lights_add"
					AtlasSprite
					{
						File = "projectile_glow.png"
						Size = [2, 3]
					}
				}
				ProjectileFancyLightSprite
				{
					Type = Sprite
					ChainedTo = Projectile
					Layer = "roof_lights_fancy"
					AtlasSprite
					{
						File = "./Data/ships/common/light_blob.png"
						Size = [6, 6]
						Z = 0.25 // Controls the "height" of the light for the purposes of normal mapping. Set to -1 (or any negative number) to disable normal lighting for this light.
						VertexColor
						{
							Rf = 0.69*12
							Gf = 0.96383333*12
							Bf = 1*12
							Af = 1
						}
					}
				}
				ProjectileSprite
				{
					Type = Sprite
					ChainedTo = Projectile
					Layer = "walls"
					AtlasSprite
					{
						File = "projectile.png"
						Size = [1.5, 2.25]
					}
				}
			}
		}

		ProjectileSound
		{
			Type = ContinuousEffects
			ChainedTo = Projectile
			OperationalToggle = ProjectileToggle
			FactorMediaEffectsIntensityWith = Projectile
			MediaEffects
			[
				: /BASE_SOUNDS/AudioExterior
				{
					Sound = "rail.wav" //"../common_effects/sounds/MassDriver.wav"
					Volume = 2
					Speed = .8
					RampUpTime = .05
					RampDownTime = .25
					AllowStacking = false
					VolumeOverIntensity = 1
					SpeedOverIntensity = [0.5, 1]
				}
			]
		}


/*
		TurretGraphicsHigh
		{
			Type = Graphics
			ChainedTo = Turret
			Location = [1.36, 0]
			Rotation = 90d
			OperationalToggle = IsOperational
