					File = "../base/batteries4.png"
					MirrorU = true
					Size = [1, 1]
				}
			]
		}

		BatterySpritesB
		{
			Type = ResourceSprites
			Location = [.5, .5]
			ResourceStorage = BatteryStorage
			Layer = "doodads_high"
			RangeLow = 1001
			RangeHigh = 2000
