		TurretGraphicsLow
		{
			Type = Graphics
			ChainedTo = Turret
			Location = [1.36, 0]
			Rotation = 90d
			OperationalToggle = IsOperational
			OperationalDoodad
			{
				Layer = "weapons"
				DamageLevels
				[
					{
						AnimationFiles
						[
