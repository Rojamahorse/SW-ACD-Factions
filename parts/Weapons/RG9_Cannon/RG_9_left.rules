//OVERCLOCK
//{
//	BULLET = &<../common_shots/rg_9_shot/rg_9_shot_overclock.rules>
//	SHOT_HEAT_PER_MODULE = 1750
//	BASE_CHARGE_TIME = 0.5
//	MODULE_CHARGE_TIME = 0.125
//	RECOIL_FACTOR = 250%
//}

Part : &<../../base_part_terran_weapons.rules>/Part
//Part :  <./Data/ships/terran/base_part_terran.rules>/Part 
{
	//IDs
	ID = SW.fighter_rg_9_cannon_left
	OtherIDs = [/*SW.a_wing_laserL,SW.a_wing_laserR,*/SW.fighter_rg_9_cannon_right]
	FlipWhenLoadingIDs = [SW.fighter_rg_9_cannon_right/*,SW.a_wing_laserR*/]

	//StringKeys
	NameKey = "Parts/RG9CannonLeft"
	IconNameKey = "Parts/RG9CannonLeftIcon"
	DescriptionKey = "Parts/RG9CannonLeftDesc"
	
	//Groups&Categories
	EditorGroups = ["WeaponsEnergy","SWTechI"]
	TypeCategories = [weapon, uses_power]
	SignificanceToggle = ScorchedToggle
	
	//Resources&Size&Health
	Resources
	[
		[steel, 22]
		[coil, 8]
	]
	Size = [1, 1]
	MaxHealth = 2000
	
	//Rects
	PenetrationRectType = Normal
	ProhibitRects
	[
		[fighter, [-1, -1, 1, 1]] 
	]
	CustomCollider
	[
		[0, -0.37]
		[0.40, -0.33]
		[1, 0]
		[1, 1]
		[0, 1]
	]
	
	//Selections
	SelectionTypeID = "fighter"
	SelectionPriority = 1
	SelectionTypeByRotation = true
	
	//PartSpecific
	InitialPenetrationResistance = 1
	IsFlippable = true
	Density = 0.5
	
	//ReceivableBuffs
	ReceivableBuffs : ^/0/ReceivableBuffs []
	ProhibitedBy : ^/0/ProhibitedBy [fighter]
	
	//Doors&Etc
	
	//Editor
	EditorIcon
	{
		Texture
		{
			File = "icon_left.png"
			SampleMode = Linear
		}
		Size = [96, 48]
	}
	
	//Components
	Components : ^/0/Components
	{
		IsOperational
		{
			Type = MultiToggle
			Toggles = [PowerToggle, BatteryStorage, ScorchedToggle/*, &~/Part/^/0/OVERCLOCK_OPERATIONAL*/]
			Mode = All
		}

		CommandConsumptionToggle
		{
			Type = MultiToggle
			Toggles = [PowerToggle, ScorchedToggle]
			Mode = All
		}

		PowerToggle
		{
			Type = UIToggle
			ToggleID = "on_off"
			Default = 1
			RequiresCommand = false
		}

		ScorchedToggle
		{
			Type = StatusToggle
			StatusType = cosmoteer.scorched
			MinStatusValue = 1
			Invert = true
		}

		CommandConsumer
		{
			Type = CommandConsumer
			OperationalToggle = CommandConsumptionToggle //PowerToggle
			CommandPoints = 2
		}

		FireModeToggle
		{
			Type = UIToggle
			ToggleID = "fire_mode"
			Default = 1
			ToggledOnChoices = [0, 1, 2]
		}
		AutoTargetToggle
		{
			Type = ModeToggle
			Mode = FireModeToggle
			OnModes = [1, 2]
		}
		AutoFireToggle
		{
			Type = ModeToggle
			Mode = FireModeToggle
			OnMode = 2
		}

		BatteryStorage
		{
			Type = ResourceStorage
			ResourceType = battery
			MaxResources = 2500
			ReceiveResourceMediaEffects = &/COMMON_EFFECTS/PowerDeliver
		}
		BatteryConsumer
		{
			Type = ResourceConsumer
			ResourceType = battery
			Storage = BatteryStorage
			ResupplyThreshold = 1
			DefaultPriority = &/PRIORITIES/Weapon_Supply
			OperationalToggle = PowerToggle
		}
/*
		RailgunBuffToggle
		{
			Type = BuffToggle
			BuffType = Railgun
		}

		RailgunOperationBuffToggle
		{
			Type = BuffToggle
			BuffType = RailgunOperation
		}

		ShotBuffProvider
		{
			Type = SelfBuffProvider
			BuffType = RailgunShot
			ChainsFromBuffType = Railgun
			BuffAmount = { BaseValue=0; BuffType=Railgun; BuffMode=Add; }
		}
		Overclock_ShotBuffProvider : ShotBuffProvider
		{
			OperationalToggle = IsOverclocked
			BuffType = RailgunShotOverclock
		}

		ReverseOperationBuffProvider
		{
			Type = AreaBuffProvider
			BuffType = RailgunReverseOperation
			BuffArea = [0, 4, 2, 1]
			OperationalToggle = IsOperational
			Criteria
			{
				Rot = 0
				Left = 0
				Right = 2
				Top = 4
			}
		}
*/
		Graphics
		{
			Type = Graphics
			Location = [.5, .5]
			OperationalToggle = IsOperational
			Floor
			{
				Layer = "floors"
				DamageLevels
				[
					{
						File = "./Data/ships/terran/point_defense/floor.png"
						Size = [1, 1]
					}
					{
						File = "./Data/ships/terran/point_defense/floor_33.png"
						Size = [1, 1]
					}
					{
						File = "./Data/ships/terran/point_defense/floor_66.png"
						Size = [1, 1]
					}
				]
			}
			OperationalDoodad
			{
				Layer = "doodads_low"
				Offset = [0, -0.5]
				DamageLevels
				[
					{
						AnimationFiles
						[
							"../base/doodads_on1D.png"
							"../base/doodads_on2D.png"
							"../base/doodads_on3D.png"
							"../base/doodads_on4D.png"
							"../base/doodads_on5D.png"
							"../base/doodads_on6D.png"
							"../base/doodads_on7D.png"
							"../base/doodads_on8D.png"
						]
						NormalsAnimationFiles
						[
							"../base/doodadsD_normals.png"
							"../base/doodadsD_normals.png"
							"../base/doodadsD_normals.png"
							"../base/doodadsD_normals.png"
							"../base/doodadsD_normals.png"
							"../base/doodadsD_normals.png"
							"../base/doodadsD_normals.png"
							"../base/doodadsD_normals.png"
						]
						Size = [1, 2]
						AnimationInterval = 0.1
					}
				]
			}
			NonOperationalDoodad
			{
				Layer = "doodads_low"
				Offset = [0, -0.5]
				DamageLevels
				[
					{
						File = "../base/doodads_offD.png"
						NormalsFile = "../base/doodadsD_normals.png"
						Size = [1, 2]
					}
				]
			}
			OperationalLighting
			{
				Layer = "lights_add"
				DamageLevels
				[
					{
						File = "../base/lights.png"
						Size = [1, 1]
					}
				]
			}
			Walls
			{
				Layer = "walls"
				DamageLevels
				[
					{
						File = "./Data/ships/terran/point_defense/walls.png"
						Size = [1, 1]
					}
					{
						File = "./Data/ships/terran/point_defense/walls_33.png"
						Size = [1, 1]
					}
					{
						File = "./Data/ships/terran/point_defense/walls_66.png"
						Size = [1, 1]
					}
				]
			}
			Roof
			{
				Layer = "roofs"
				DamageLevels
				[
					{
						File = "./Data/ships/terran/point_defense/roof.png"
						NormalsFile = "./Data/ships/terran/point_defense/roof_normals.png"
						Size = [1, 1]
					}
					{
						File = "./Data/ships/terran/point_defense/roof_33.png"
						NormalsFile = "./Data/ships/terran/point_defense/roof_normals_33.png"
						Size = [1, 1]
					}
					{
						File = "./Data/ships/terran/point_defense/roof_66.png"
						NormalsFile = "./Data/ships/terran/point_defense/roof_normals_66.png"
						Size = [1, 1]
					}
				]
			}
		}

		Turret
		{
			Type = TurretWeapon
			Location = [0.5, -0.25]
			Rotation = -180d
			OperationalToggle = IsOperational
			AutoFireToggle = AutoFireToggle
			FireInterval = .8
			FiringArc = 15d
			RotateSpeed = 90d
			FireThresholdAngle = 3d
			AIFirepowerRating = &~/Part/StatsByCategory/0/Stats/DamagePerSecond
			AllowFireWithBlockedLOS = true
			IgnoreSourceShipLowLOSChecks = true
			IgnoreSourceShipLOSChecks = true
			IgnoreFriendlyShipLowLOSChecks = false
			UseResourcePerShotInBurst = true
			Emitter = BulletEmitter

			AutoTargets
			[
				{
					TargetType = ShipParts
					Toggle = FireModeToggle
				}
			]

			BlueprintArcSprite
			{
				Texture = &/INDICATORS/WeaponArc
				Size = [0, 1.5]
				Color = [255, 0, 0, 63]
			}
			BlueprintArcRadius = 10
			BlueprintArcSpriteSegments = 64

			CoverageSectorArc
			{
				Texture = &/INDICATORS/VerticalGradient
				VertexColor = [255, 255, 255, 51]
				QuadCount = 64
			}
		}

		ReloadProgressBar
		{
			Type = ProgressBar
			OperationalToggle = IsOperational
			ShowProgressFor = Turret
		}
/*
		// Prevent toggling while firing
		OverclockModeToggle : ^/0/OverclockModeToggle
		{
			OperationalToggle = ProjectileToggle
			InvertOperationalToggle = true
		}

		Overclock_ShotHeatProducer
		{
			Type = ResourceChange
			Trigger = Overclock_BulletEmitter
			Amount
			{
				PER_MODULE_RESOURCE_HEAT = (&~/OVERCLOCK/SHOT_HEAT_PER_MODULE) * (&<./Data/statuses/heat/heat.rules>/STATUS_TO_RESOURCE_RATIO)
				// 2 for the launcher and loader
				BaseValue = 2 * (&PER_MODULE_RESOURCE_HEAT)
				Modifiers
				[
					{
						Type = ScaledBuff
						BuffType = Railgun
						Scale = (&../../PER_MODULE_RESOURCE_HEAT)
						ModificationMode = Add
					}
				]
			}
			ResourceStorage = &~/Part/^/0/HEAT_TARGET_STORAGE
		}

		HeatDistributionStorage : ^/0/HeatDistributionStorage
		{
			ResourceStorages = [ &../^/0/ResourceStorages/0, Network_RailgunOverflowHeatInput ]
		}

		WeaponEmitterSelector
		{
			Type = ToggleEmitterSelector
			Toggle = IsOverclocked
			ToggleOffEmitter = BulletEmitter
			ToggleOnEmitter = Overclock_BulletEmitter
		}

*/
		BulletEmitter
		{
			Type = BulletEmitter
			ChainedTo = Turret
			FireTrigger = Turret
			GetTargetFrom = Turret
			Location = [1.38, 0]
			OperationalToggle = IsOperational
			Bullet = &<../common_shots/rg_9_shot/rg_9_shot.rules>
			Spread = [-2d, 2d]
			Burst = 3
			BurstDelay = 0.1
			ResourceStorage = BatteryStorage
			ResourcesUsed = 125
			MinResourcesUsed = 1
		}
/*
		Overclock_BulletEmitter : BulletEmitter
		{
			FireTrigger = ProjectileFinished_Charged
			Bullet = &~/OVERCLOCK/BULLET
		}
		EmissionTriggered
		{
			Type = MultiTrigger
			Triggers = [BulletEmitter, Overclock_BulletEmitter]
		}

		WeaponTriggerProxy_NonOverclocked
		{
			Type = TriggerProxy
			ComponentID = Weapon
			ProxyToggle = IsOperationalNonOverclocked
		}

		WeaponTriggerProxy_Overclocked
		{
			Type = TriggerProxy
			ComponentID = Weapon
			ProxyToggle = IsOperationalOverclocked
		}

		OperationalOverclockDisabled
		{
			Type = ToggleTrigger
			Toggle = IsOperationalOverclocked
			TriggerWhenOn = false
			TriggerWhenOff = true
		}

		Overclock_ChargeTimerReset
		{
			Type = MultiTrigger
			Triggers = [WeaponTriggerProxy_Overclocked, OperationalOverclockDisabled]
		}
		Overclock_ChargeTimer
		{
			Type = Timer
			OperationalToggle = IsOperationalOverclocked
			Duration
			{
				BaseValue = &~/OVERCLOCK/BASE_CHARGE_TIME
				MaxValue = (&~/Part/Components/Weapon/FireInterval) - 0.5
				Modifiers
				[
					{
						Type = ScaledBuff
						BuffType = Railgun
						Scale = &~/OVERCLOCK/MODULE_CHARGE_TIME
						ModificationMode = Add
					}
				]
			}
			StartTrigger = WeaponTriggerProxy_Overclocked
			ResetTrigger = Overclock_ChargeTimerReset
			StopTrigger = OperationalOverclockDisabled
		}
		Overclock_PolledChargeTimer
		{
			Type = PolledValue
			OperationalToggle = Overclock_ChargeTimer
			InvertOperationalToggle = true
			ValueSource = Overclock_ChargeTimer
			DefaultValue = 1
		}
		Overclock_ChargeValue
		{
			Type = MultiValue
			Values = [ Overclock_PolledChargeTimer ]
			Mode = Add
			Invert = true
		}

		Overclock_HasCharged
		{
			Type = TriggeredToggle
			OnTrigger = Overclock_ChargeTimer
			OffTrigger = Overclock_BulletEmitter
			OperationalToggle = IsOperationalOverclocked
		}

		RailgunBuffValue
		{
			Type = BuffableValue
			Value = { BaseValue = 1; BuffType = Railgun; BuffMode = Multiply; }
			IncludeInBlueprints = true
		}
		Overclock_ChargeableModuleCount
		{
			Type = MultiValue
			Values = [RailgunBuffValue, One]
			Mode = Add
		}
		Overclock_ChargedModules
		{
			Type = MultiValue
			Values = [Overclock_ChargeValue, Overclock_ChargeableModuleCount]
			Mode = Multiply
		}

		ProjectileStartTrigger
		{
			Type = MultiTrigger
			Triggers = [WeaponTriggerProxy_NonOverclocked, Overclock_ChargeTimer]
		}
*/
		FireEffect
		{
			Type = TriggeredEffects
			ChainedTo = Turret
			Trigger = Turret
			Location = [1.8675, 0]
			AnchorMediaEffects = true

			MediaEffects
			[
				&<./Data/ships/terran/laser_blaster_small/particles/laser_blaster_small_shoot.rules>
				&<./Data/ships/terran/laser_blaster_small/particles/laser_blaster_small_shoot_flash.rules>

				: /BASE_SOUNDS/AudioExterior
				{
					Sound = "../common_effects/sounds/sw_HOUNDSTOOTH_1.WAV"
					Volume = .3
					SpeedVariation = .25
				}
			]
		}
/*
		Router
		{
			Type = NetworkRouter
			RouteGenerators
			[
				{
					Type = Bidirectional
					Routes
					[
						[NetworkOverclockStateValue, Networked_ChargedModules, 0]
						[NetworkOverclockStateValue, Networked_ChargeValue, 0]
						[NetworkOverclockStateValue, Network_OverflowHeatStorage, 0]
						[NetworkOverclockStateValue, Network_RailgunOverflowHeatInput, 0]
					]
				}
				{
					Type = Simple
					Routes
					[
						[&~/Part/^/0/HEAT_NETWORK_INPUT, NetworkOverclockStateValue, 0]
					]
				}
			]
		}

		Networked_ChargedModules
		{
			Type = NetworkValue
			ValueSource = Overclock_ChargedModules
			Categories = [ railgun_charge_modules ]
		}

		Networked_ChargeValue
		{
			Type = NetworkValue
			ValueSource = Overclock_ChargeValue
			Categories = [ railgun_charge ]
		}

		Network_RailgunOverflowHeatInput
		{
			Type = NetworkResourceInput
			ResourceType = heat
			AllowUncategorized = false
			Categories = [ railgun_heat_overflow ]
		}

		Network_OverflowHeatStorage
		{
			Type = NetworkResourceStore
			ResourceType = heat
			ResourceStorage = OverflowHeatStorage
			AllowProviding = false
			Categories = [ railgun_heat_overflow ]
		}

		NetworkOverclockStateValue
		{
			Type = NetworkValue
			ValueSource = OverclockStateValue
			Categories = [ overclock ]
		}

		OverclockStateValue
		{
			Type = ToggleValueSelector
			Toggle = OverclockModeToggle
			ToggleOffValue = Zero
			ToggleOnValue = One
		}

		BlueprintNetwork_IsOverclocked
		{
			Type = NetworkToggle
			ToggleSource = OverclockModeToggle
			Categories = [ overclock ]
			IncludeInBlueprints = true
			IncludeInPhysical = false
		}

		Zero
		{
			Type = StaticValue
			Value = 0
		}
		One
		{
			Type = StaticValue
			Value = 1
		}

		Port_Rail
		{
			Type = NetworkPort
			Location = [0, 3]
			Direction = Down
			Types = [ railgun_down ]
			CompatibleTypes = [ railgun_up ]
			RouteSource = NetworkOverclockStateValue
			RouteEndpoint = NetworkOverclockStateValue
			BlueprintRouteSource = BlueprintNetwork_IsOverclocked
			BlueprintRouteEndpoint = BlueprintNetwork_IsOverclocked
			Overlay
			{
				RouteDrawMode = Never
				IconDrawMode = Never
			}
		}

		Port_Thermal_TopLeft : ~/Part/^/0/BASE_THERMAL_PORT
		{
			Location = [0, 1]
			Direction = Left
			Overlay : ^/0/Overlay
			{
				SpreadHighlightThroughNetwork = BlueprintNetwork_IsOverclocked
			}
		}
		Port_Thermal_TopRight : Port_Thermal_TopLeft
		{
			Location = [1, 1]
			Direction = Right
		}
		Port_Thermal_BottomLeft : Port_Thermal_TopLeft
		{
			Location = [0, 3]
			Direction = Left
		}
		Port_Thermal_BottomRight : Port_Thermal_TopLeft
		{
			Location = [1, 3]
			Direction = Right
		}
*/

		TurretGraphicsLow
		{
			Type = Graphics
			ChainedTo = Turret
			Location = [0.50, 0] // .86
			Rotation = 90d
			OperationalToggle = IsOperational
			OperationalDoodad
			{
				Layer = "weapons"
				DamageLevels
				[
					{
						File = "turret.png"
						NormalsFile = "turret_normals.png"
						Size = [1, 3]
					}
				]
			}
			NonOperationalDoodad = &OperationalDoodad
		}


		BatterySpritesA
		{
			Type = ResourceSprites
			Location = [.5, .5]
			ResourceStorage = BatteryStorage
			Layer = "doodads_high"
			RangeLow = 0
			RangeHigh = 1000
			ResourceLevels
			[
				{
					File = "../base/batteries4.png"
					MirrorU = true
					Size = [1, 1]
				}
			]
		}

		BatterySpritesB
		{
			Type = ResourceSprites
			Location = [.5, .5]
			ResourceStorage = BatteryStorage
			Layer = "doodads_high"
			RangeLow = 1001
			RangeHigh = 2000
			ResourceLevels
			[
				{
					File = "../base/batteries4.png"
					Size = [1, 1]
				}
			]
		}


		OperationEffects
		{
			Type = ToggleEffects
			Location = [.5, 1.5]
			Toggle = IsOperational
			ToggledOnMediaEffects = &/COMMON_EFFECTS/PowerOn
			ToggledOffMediaEffects = &/COMMON_EFFECTS/PowerOff
		}

		ScorchedTrigger
		{
			Type = ToggleTrigger
			Toggle = ScorchedToggle
			TriggerWhenOn = false
		}

		ScorchedEffects
		{
			Type = TriggeredEffects
			Trigger = ScorchedTrigger
			Location = &../DestroyedEffects/Location
			MediaEffects = &/COMMON_EFFECTS/MedPartScorched
		}

		DestroyedEffects
		{
			Type = DeathEffects
			MediaEffects = &/COMMON_EFFECTS/SmallPartDestroyed
			Location = [.5, .5]
		}

		Indicators
		{
			Type = IndicatorSprites
			Location = [.5, .5]
			Indicators
			[
				// 0: Scorched  
				{
					Toggle = ScorchedToggle
					AtlasSprite = &/INDICATORS/Scorched
					HidesIndicators = [1,2]     // hide Power and Out-of-power
				}
				// 1: Powered off  
				{
					Toggle = PowerToggle
					AtlasSprite
					{
						File = &/INDICATORS/PowerOff
						Size = [1, 1]
					}
					HidesIndicators = [2]       // only hide Out-of-power
				}
				// 2: Out of power  
				{
					Toggle = BatteryStorage
					AtlasSprite
					{
						File = &/INDICATORS/NoPower
						Size = [1, 1]
					}
					// no HidesIndicators → doesn’t explicitly hide anything
				}
			]
		}

		Blueprints
		{
			Type = BlueprintSprite
			OnlyWithFlip = false
			File = "blueprints_left.png"
			Size = [4, 2]
			Offset = [-0.5, -0.5]
		}
		BlueprintsFlipped
		{
			Type = BlueprintSprite
			OnlyWithFlip = true
			File = "blueprints_left.png"
			Size = [4, 2]
			Offset = [-0.5, -0.5]
		}
	}

	Stats
	{
		PowerCapacity = (&~/Part/Components/BatteryStorage/MaxResources) / 1000
		//TurretPenResist = &~/Part/Components/TurretCollider/InitialPenetrationResistance

		MinPower = (&../StatsByCategory/0/Stats/PowerPerSecond) / 2
		RecPower = &../StatsByCategory/0/Stats/PowerPerSecond
		MinCrew = (&MinPower) * 2
		RecCrew = (&RecPower) * 4
	}

	StatsByCategory
	[
		{
			NameKey = "StatCategories/SWRG9Shot"
			Stats
			{
				ShieldDamagePerShot = &~/Part/Components/BulletEmitter/Bullet/SWDamageValueSh
				ShieldDamagePerSecond = (&ShieldDamagePerShot) * (&ROF)
				ShieldDamage = [&../ShieldDamagePerShot, &../ShieldDamagePerSecond]
				DamagePerShot = &~/Part/Components/BulletEmitter/Bullet/SWDamageValueOp
				DamagePerSecond = (&DamagePerShot) * (&ROF)
				Damage = [&../DamagePerShot, &../DamagePerSecond]
				ROF = 1 / (&~/Part/Components/Turret/FireInterval)
				Range = &~/Part/Components/BulletEmitter/Bullet/Range
				Arc = deg(&~/Part/Components/Turret/FiringArc)
				TurretSpeed = deg(&~/Part/Components/Turret/RotateSpeed)
				ShotSpeed = &~/Part/Components/BulletEmitter/Bullet/Speed
				Burst = &~/Part/Components/BulletEmitter/Burst
				Spread = deg(&~/Part/Components/BulletEmitter/Spread/1)
				ShotHP = &~/Part/Components/BulletEmitter/Bullet/Components/Targetable/Health
				PowerPerShot = (&~/Part/Components/BulletEmitter/ResourcesUsed) / 1000
				PowerPerSecond = (&PowerPerShot) * (&ROF)
				ShotPowerUsage = [&../PowerPerShot, &../PowerPerSecond]
			}
		}
	]
}
