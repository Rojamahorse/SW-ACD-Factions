Type = None
SubSpawners
[
	&~/PirateHunter

	: ~/BaseFactionHunter { v_Faction=fringe }
	: ~/BaseFactionHunter { v_Faction=monolith }
	: ~/BaseFactionHunter { v_Faction=cabal }
	: ~/BaseFactionHunter { v_Faction=imperium }
	: ~/BaseFactionHunter { v_Faction=io }
	: ~/BaseFactionHunter { v_Faction=SW.Black_Sun }
	: ~/BaseFactionHunter { v_Faction=SW.CIS }
	: ~/BaseFactionHunter { v_Faction=SW.Galactic_Empire }
	: ~/BaseFactionHunter { v_Faction=SW.Republic }
	: ~/BaseFactionHunter { v_Faction=SW.Rebel_Alliance }

	: ~/BaseExploration { v_DiscoverCountFraction=25% }
	: ~/BaseExploration { v_DiscoverCountFraction=50%; RequirePreviousMission = true }
	: ~/BaseExploration { v_DiscoverCountFraction=75%; RequirePreviousMission = true }
	: ~/BaseExploration { v_DiscoverCountFraction=100%; RequirePreviousMission = true }
]

PirateHunter
{
	Type = Mission
	Metatype = PirateHunt
	SpawnAt = SimGlobal
	Faction = SystemController
	Objectives
	[
		{
			Type = Sequential
			SubObjectives
			[
				{
					Type = DefeatShips
					TargetsTag = { Tag=pirate; }
					TargetCountFraction = 50%
					MissionInvalidIfZeroTargets = true
					AllowNpcKills = false
					OverrideDisplayFormatKey = "Objectives/DefeatRovingPirates"
				}
				{
					Type = ReceiveRewards
				}
			]
		}
	]
	Rewards
	[
		{
			Type = Money
			MoneyPerHighTier = &/TIER_TABLES/StandardMoneyPerTier
			MoneyPerTierMultiplier = 2
			RoundToMultiple = 500
		}
		{
			Type = Fame
			FamePerHighTier = &/TIER_TABLES/StandardFamePerTier
			FamePerTierMultiplier = 2
			MaxFamePerHighTier = &/TIER_TABLES/StandardMaxFamePerTier
		}
        {
            Type = Reputation
            ReputationPerHighTier = &/TIER_TABLES/StandardReputationPerTier
            ReputationPerTierMultiplier = 2
        }
	]
}

BaseFactionHunter
{
	v_Faction // VIRTUAL; must be inherited

	Type = Mission
	Metatype = FactionHunt
	SpawnAt = Tag
	SpawnAtTag = { Mode=Random; Tag=trade_station; OnlyOpposingFactions=true; }
	OkayIfSpawnAtTagNotFound = true
	Faction = OwnerOfTag
	FactionTag = &SpawnAtTag
	OkayIfFactionTagNotFound = true
	Objectives
	[
		{
			Type = Sequential
			SubObjectives
			[
				{
					Type = DefeatShips
					TargetsTag = { Tag=faction_wanderer; OnlyFactions=[&~/BaseFactionHunter/:/v_Faction]; }
					TargetCountFraction = 50%
					MissionInvalidIfZeroTargets = true
					AllowNpcKills = false
					OverrideDisplayFormatKey = "Objectives/DefeatFactionShips"
				}
				{
					Type = ReceiveRewards
				}
			]
		}
	]
	Rewards
	[
		{
			Type = Money
			MoneyPerHighTier = &/TIER_TABLES/StandardMoneyPerTier
			MoneyPerTierMultiplier = 2
			RoundToMultiple = 500
		}
		{
			Type = Fame
			FamePerHighTier = &/TIER_TABLES/StandardFamePerTier
			FamePerTierMultiplier = 2
			MaxFamePerHighTier = &/TIER_TABLES/StandardMaxFamePerTier
		}
        {
            Type = Reputation
            ReputationPerHighTier = &/TIER_TABLES/StandardReputationPerTier
            ReputationPerTierMultiplier = 2
        }
	]
}

BaseExploration
{
	v_DiscoverCountFraction // VIRTUAL; must be inherited

	Type = Mission
	Metatype = Explore
	SpawnAt = SimGlobal
	Faction = SystemController
	Objectives
	[
		{
			Type = Sequential
			SubObjectives
			[
				{
					Type = DiscoverPOIs
					POITags = [poi_unknown]
					DiscoverCountFraction = &~/BaseExploration/:/v_DiscoverCountFraction
				}
				{
					Type = ReceiveRewards
				}
			]
		}
	]
	Rewards
	[
		{
			Type = Money
			MoneyPerHighTier = &/TIER_TABLES/StandardMoneyPerTier
			RoundToMultiple = 500
		}
		{
			Type = Fame
			FamePerHighTier = &/TIER_TABLES/StandardFamePerTier
			MaxFamePerHighTier = &/TIER_TABLES/StandardMaxFamePerTier
		}
        {
            Type = Reputation
            ReputationPerHighTier = &/TIER_TABLES/StandardReputationPerTier
        }
	]
}