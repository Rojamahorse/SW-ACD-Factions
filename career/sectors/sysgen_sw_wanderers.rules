Type = None
SubSpawners
[
	// Pirates.
	{
		Type = Ships
		Tags = [pirate]
		Count = [14, 16]
		Distance = [0, 18000]
		MinDistanceFromTags = [[sun, 6000], [station, 2000], [pirate, 4500]]
		MinDistanceFromNebulas = [[ion_storm, 500]]
		SuppressLocationAssertions = true
		Allegiance = Unique
     	SynchronizeAllegiance = true
		NameGenerator = &<../../name_generators/sw_name_villains.rules>/VilNameGen
		FamePerTier = &/TIER_TABLES/StandardFamePerTier
		MaxFamePerTier = &/TIER_TABLES/StandardMaxFamePerTier
		ShipCriteria
		{
			UseLocalFactionWeights = true
			UseTierField = true
			AllowTierRangeExpansion = true
			Tags = [combat]
			UseEvenShipTypeDistribution = false //true
			FleetTierRemapTable = &/SW_FLEET_TIER_REMAP_TABLE/FleetTierRemapTable
		}
		AI
		{
			Type = Wanderer
			PatrolRadius = 7500
			StasisSpeed = 100
		}
	}
	{
		Type = Ships
		Tags = [pirate]
		Count = [4, 8]
		Distance = [0, 18000]
		MinDistanceFromTags = [[sun, 6000], [station, 2000], [pirate, 4500]]
		MinDistanceFromNebulas = [[ion_storm, 500]]
		SuppressLocationAssertions = true
		Allegiance = Unique
     	SynchronizeAllegiance = true
		NameGenerator = &<../../name_generators/sw_name_villains.rules>/VilNameGen
		FamePerTier = &/TIER_TABLES/StandardFamePerTier
		MaxFamePerTier = &/TIER_TABLES/StandardMaxFamePerTier
		ShipCriteria
		{
			UseLocalFactionWeights = true
			UseTierField = true
			AllowTierRangeExpansion = true
			Tags = [combat]
			UseEvenShipTypeDistribution = false //true
			//FleetTierRemapTable = &/SW_FLEET_TIER_REMAP_TABLE/FleetTierRemapTable
		}
		AI
		{
			Type = Wanderer
			PatrolRadius = 7500
			StasisSpeed = 100
		}
	}
	// Faction wanderers.
	{
		Type = Ships
		Tags = [faction_wanderer]
		Count = [10, 16]
		Distance = [0, 18000]
		MinDistanceFromTags = [[sun, 6000], [station, 500]]
		MinDistanceFromNebulas = [[ion_storm, 500]]
		SuppressLocationAssertions = true
		Allegiance = FactionMilitary
		FamePerTier = &/TIER_TABLES/StandardFamePerTier
		MaxFamePerTier = &/TIER_TABLES/StandardMaxFamePerTier
		ShipCriteria
		{
			UseLocalFactionWeights = true
			UseLocalTier = true
			//UseTierField = true
			AllowTierRangeExpansion = true
			Tags = [combat]
			//FleetTierRemapTable = &/SW_FLEET_TIER_REMAP_TABLE/PatrolTierRemapTable
		}
		AI
		{
			Type = Wanderer
			PatrolRadius = &../Distance/1
			PatrolAroundWorldOrigin = true
			StasisSpeed = 100
		}
	}
	// Faction Patrol Groups.
	{
		Type = Ships
		Tags = [faction_wanderer]
		Count = [4, 8]
		Distance = [0, 18000]
		MinDistanceFromTags = [[sun, 6000], [station, 500]]
		MinDistanceFromNebulas = [[ion_storm, 500]]
		SuppressLocationAssertions = true
		Allegiance = FactionMilitary
		FamePerTier = &/TIER_TABLES/StandardFamePerTier
		MaxFamePerTier = &/TIER_TABLES/StandardMaxFamePerTier
		ShipCriteria
		{
			UseLocalFactionWeights = true
			//UseLocalTier = true
			UseTierField = true
			AllowTierRangeExpansion = true
			Tags = [combat]
			FleetTierRemapTable = &/SW_FLEET_TIER_REMAP_TABLE/PatrolTierRemapTable
		}
		AI
		{
			Type = Wanderer
			PatrolRadius = &../Distance/1
			PatrolAroundWorldOrigin = true
			StasisSpeed = 100
		}
	}
]

